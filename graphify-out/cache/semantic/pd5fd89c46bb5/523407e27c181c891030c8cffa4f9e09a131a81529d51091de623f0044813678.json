{"nodes": [{"id": "readme_spotidex", "label": "SpotiDex", "file_type": "document", "source_file": "README.md", "source_location": "L1-L24", "source_url": null, "captured_at": null, "author": "Yash Kokane", "contributor": null, "rationale": "A retro hi-fi pixel-art Spotify companion with dynamic album-art theming and tactile physical controls."}, {"id": "readme_tactile_vinyl_deck", "label": "Tactile Vinyl Deck & Tonearm Physics", "file_type": "concept", "source_file": "README.md", "source_location": "L89-L92", "source_url": null, "captured_at": null, "author": "Yash Kokane", "contributor": null, "rationale": "Modern streaming apps are sterile; tactile vinyl turntable with needle-drop physics and fling gestures restores tactile soul to digital playback."}, {"id": "readme_chromotherapy", "label": "Chromotherapy Dynamic Album Palette", "file_type": "concept", "source_file": "README.md", "source_location": "L93-L96", "source_url": null, "captured_at": null, "author": "Yash Kokane", "contributor": null, "rationale": "Dynamic album art palettes often produce illegible neon text; SpotiDex enforces automated WCAG AA minimum 4.5:1 contrast ratios on extracted CSS variables."}, {"id": "readme_audio_visualizer", "label": "36-Band Deterministic Audio Visualizer", "file_type": "concept", "source_file": "README.md", "source_location": "L97-L100", "source_url": null, "captured_at": null, "author": "Yash Kokane", "contributor": null, "rationale": "Spotify Web API does not provide raw PCM audio bytes to web apps; Mulberry32 seeded by Spotify Track ID creates reproducible per-track LED visualizer patterns."}, {"id": "readme_queue_carousel", "label": "3D Perspective Queue Carousel", "file_type": "concept", "source_file": "README.md", "source_location": "L101-L104", "source_url": null, "captured_at": null, "author": "Yash Kokane", "contributor": null, "rationale": "Interactive 3D cylindrical queue powered by GSAP allows smooth scrolling and direct click-to-play with drag-cancellation sa